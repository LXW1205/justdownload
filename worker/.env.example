# Port the worker listens on (reverse proxy in front of this on 443).
PORT=3001

# Comma-separated list of origins allowed to call the worker via CORS.
# Use the URL where the Vercel app is deployed.
# Example: ALLOWED_ORIGINS=https://ytdl-term.vercel.app,http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# Where downloaded files and per-session cookies live on disk.
# Default: /tmp/ytdl-term  (cleared on reboot)
WORK_DIR=/tmp/ytdl-term
